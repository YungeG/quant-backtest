{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/comparator-contract-v1.schema.json",
  "title": "Comparator Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "comparison"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "comparison": {"const": "exact"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "comparison"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "comparison": {"const": "sequence"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "comparison", "quantum", "rounding"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "comparison": {"const": "quantized"},
              "quantum": {"type": "string", "minLength": 1},
              "rounding": {
                "enum": [
                  "ROUND_CEILING",
                  "ROUND_DOWN",
                  "ROUND_FLOOR",
                  "ROUND_HALF_DOWN",
                  "ROUND_HALF_EVEN",
                  "ROUND_HALF_UP",
                  "ROUND_UP"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "comparison"],
            "anyOf": [
              {"required": ["absolute_tolerance"]},
              {"required": ["relative_tolerance"]}
            ],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "comparison": {"const": "explicit_tolerance"},
              "absolute_tolerance": {"type": "string", "minLength": 1},
              "relative_tolerance": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "comparison", "reference"],
            "properties": {
              "path": {"type": "string", "pattern": "^/"},
              "comparison": {"const": "approved_change"},
              "reference": {
                "type": "string",
                "pattern": "^docs/adr/"
              }
            }
          }
        ]
      }
    }
  }
}
